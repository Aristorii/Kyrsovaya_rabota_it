const HEADERS=["request_id","created_at","name","phone","email","cake_type","weight_kg","event_date","filling","decoration","inscription","comment","utm_source","utm_medium","utm_campaign","utm_content","utm_term","page_url","status"];
// Script Properties: SPREADSHEET_ID. Создайте лист leads или он будет создан автоматически.
function doPost(e){try{const b=JSON.parse((e&&e.postData&&e.postData.contents)||"{}");const req=["request_id","name","phone","cake_type","weight_kg","event_date"];const missing=req.filter(k=>!String(b[k]||"").trim());if(missing.length)return out({ok:false,error:"missing_fields",fields:missing});const w=Number(b.weight_kg);if(!Number.isFinite(w)||w<1.5||w>30)return out({ok:false,error:"invalid_weight"});const date=new Date(b.event_date+"T12:00:00"),min=new Date();min.setHours(0,0,0,0);min.setDate(min.getDate()+3);if(isNaN(date.getTime())||date<min)return out({ok:false,error:"event_date_too_soon"});const id=PropertiesService.getScriptProperties().getProperty("SPREADSHEET_ID");if(!id)return out({ok:false,error:"missing_spreadsheet_id"});const s=SpreadsheetApp.openById(id);let sh=s.getSheetByName("leads")||s.insertSheet("leads");if(!sh.getLastRow())sh.appendRow(HEADERS);const lock=LockService.getScriptLock();lock.waitLock(10000);try{const ids=sh.getLastRow()>1?sh.getRange(2,1,sh.getLastRow()-1,1).getValues().flat():[];if(ids.includes(b.request_id))return out({ok:true,duplicate:true});const u=b.utm||{};sh.appendRow([b.request_id,b.created_at||new Date().toISOString(),b.name,b.phone,b.email||"",b.cake_type,w,b.event_date,b.filling||"",b.decoration||"",b.inscription||"",b.comment||"",u.utm_source||"",u.utm_medium||"",u.utm_campaign||"",u.utm_content||"",u.utm_term||"",b.page_url||"","new"]);return out({ok:true,request_id:b.request_id})}finally{lock.releaseLock()}}catch(err){return out({ok:false,error:"server_error",message:String(err)})}}
function doGet(){return out({ok:true,service:"saharny-leads"})}function out(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}